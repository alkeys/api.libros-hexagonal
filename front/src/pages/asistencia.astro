---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Asistencia" active="asistencia">
  <div class="fade-in space-y-6">
    <!-- Registrar asistencia -->
    <div class="card overflow-hidden">
      <div class="border-b border-slate-100 px-6 py-5">
        <h2 class="text-xl font-extrabold text-ink">Registrar Asistencia</h2>
        <p class="mt-0.5 text-sm text-ink-soft">Marca presencia de un estudiante en una clase.</p>
      </div>
      <form id="asist-form" class="grid grid-cols-1 gap-4 px-6 py-5 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <label class="label">Estudiante *</label>
          <select name="idEstudiante" id="f-estudiante" class="input" required></select>
        </div>
        <div>
          <label class="label">Asignación de clase *</label>
          <select name="idAsignacion" id="f-asignacion" class="input" required></select>
        </div>
        <div>
          <label class="label">Fecha *</label>
          <input name="fecha" type="date" class="input" required value={new Date().toISOString().slice(0, 10)} />
        </div>
        <div>
          <label class="label">Estado *</label>
          <select name="estado" class="input" required>
            <option value="PRESENTE">Presente</option>
            <option value="AUSENTE">Ausente</option>
            <option value="TARDE">Tarde</option>
            <option value="JUSTIFICADA">Justificada</option>
          </select>
        </div>
        <div class="sm:col-span-2 lg:col-span-2">
          <label class="label">Observación</label>
          <input name="observacion" class="input" placeholder="Opcional" />
        </div>
        <div class="flex items-end">
          <button type="submit" class="btn-primary w-full">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            Guardar asistencia
          </button>
        </div>
      </form>
    </div>

    <!-- Listado por asignación -->
    <div class="card overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 px-6 py-5">
        <div>
          <h2 class="text-xl font-extrabold text-ink">Asistencia por Clase</h2>
          <p class="mt-0.5 text-sm text-ink-soft">Consulta el registro de una asignación.</p>
        </div>
        <select id="list-asignacion" class="input w-full max-w-sm"></select>
      </div>
      <div id="list-body" class="px-6 py-5"></div>
    </div>
  </div>
</Layout>

<script>
  import { esc, toast, badge } from '../lib/ui';
  import { fmtDate } from '../lib/crud';
  import { apiGet, apiPost } from '../lib/api';

  // Selects
  const fEstudiante = document.getElementById('f-estudiante');
  const fAsignacion = document.getElementById('f-asignacion');
  const listAsignacion = document.getElementById('list-asignacion');

  Promise.all([apiGet('/estudiantes'), apiGet('/horarios/asignaciones')])
    .then(([estudiantes, asignaciones]) => {
      fEstudiante.innerHTML = (estudiantes || [])
        .map((e) => `<option value="${esc(e.id)}">${esc(e.nombres)} ${esc(e.apellidos)}</option>`)
        .join('');
      const opts = (asignaciones || [])
        .map((a) => `<option value="${esc(a.id)}">Asignación #${esc(a.id)}</option>`)
        .join('');
      fAsignacion.innerHTML = opts;
      listAsignacion.innerHTML = opts;
      if (listAsignacion.value) loadList();
    })
    .catch(() => {
      fEstudiante.innerHTML = '<option value="">Sin datos</option>';
    });

  // Formulario
  document.getElementById('asist-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = new FormData(e.target);
    const payload = {
      idEstudiante: Number(form.get('idEstudiante')),
      idAsignacion: Number(form.get('idAsignacion')),
      fecha: form.get('fecha'),
      estado: form.get('estado'),
      observacion: form.get('observacion') || null,
    };
    try {
      await apiPost('/asistencia', payload);
      toast('Asistencia registrada', 'success');
      e.target.reset();
      e.target.querySelector('[name="fecha"]').value = new Date().toISOString().slice(0, 10);
    } catch (err) {
      toast(err.message || 'No se pudo registrar', 'error');
    }
  });

  // Listado
  const listBody = document.getElementById('list-body');

  async function loadList() {
    const id = listAsignacion.value;
    if (!id) {
      listBody.innerHTML = '<p class="text-sm font-semibold text-ink-soft">Selecciona una asignación.</p>';
      return;
    }
    listBody.innerHTML = Array.from({ length: 4 }, () => '<div class="skeleton mb-2 h-10 w-full"></div>').join('');
    try {
      const rows = (await apiGet(`/asistencia/asignacion/${id}`)) || [];
      if (!rows.length) {
        listBody.innerHTML = '<p class="text-sm font-semibold text-ink-soft">Sin registros de asistencia para esta asignación.</p>';
        return;
      }
      listBody.innerHTML = `
        <div class="overflow-x-auto rounded-xl border border-slate-100">
          <table class="w-full min-w-[480px]">
            <thead><tr class="bg-slate-50/80">
              <th class="th">Estudiante</th><th class="th">Fecha</th><th class="th">Estado</th><th class="th">Observación</th>
            </tr></thead>
            <tbody>
              ${rows.map((r) => `
                <tr class="border-t border-slate-50 transition hover:bg-brand-50/40">
                  <td class="td font-bold">#${esc(r.idEstudiante)}</td>
                  <td class="td">${fmtDate(r.fecha)}</td>
                  <td class="td">${badge(r.estado)}</td>
                  <td class="td text-ink-soft">${esc(r.observacion || '—')}</td>
                </tr>`).join('')}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs font-semibold text-ink-soft">${rows.length} registro${rows.length !== 1 ? 's' : ''}</p>`;
    } catch {
      listBody.innerHTML = '<p class="text-sm font-semibold text-rose-600">No se pudo cargar.</p>';
    }
  }

  listAsignacion.addEventListener('change', loadList);
</script>