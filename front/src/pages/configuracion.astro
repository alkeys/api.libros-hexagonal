---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configuración" active="configuracion">
  <div class="fade-in grid gap-6 xl:grid-cols-3">
    <div class="card overflow-hidden xl:col-span-2">
      <div class="border-b border-slate-100 px-6 py-5">
        <h2 class="text-xl font-extrabold text-ink">Configuración de la Institución</h2>
        <p class="mt-0.5 text-sm text-ink-soft">Datos generales y parámetros académicos.</p>
      </div>
      <form id="cfg-form" class="grid grid-cols-1 gap-4 px-6 py-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="label">Nombre de la institución *</label>
          <input name="nombreInstitucion" class="input" required />
        </div>
        <div class="sm:col-span-2">
          <label class="label">Dirección</label>
          <input name="direccion" class="input" />
        </div>
        <div>
          <label class="label">Teléfono</label>
          <input name="telefono" class="input" type="tel" />
        </div>
        <div>
          <label class="label">Correo electrónico</label>
          <input name="correo" class="input" type="email" />
        </div>
        <div>
          <label class="label">Sitio web</label>
          <input name="sitioWeb" class="input" />
        </div>
        <div>
          <label class="label">URL del logo</label>
          <input name="logoUrl" class="input" />
        </div>
        <div>
          <label class="label">Escala mínima</label>
          <input name="escalaMinima" type="number" step="0.01" class="input" />
        </div>
        <div>
          <label class="label">Escala máxima</label>
          <input name="escalaMaxima" type="number" step="0.01" class="input" />
        </div>
        <div>
          <label class="label">Nota de aprobación</label>
          <input name="notaAprobacion" type="number" step="0.01" class="input" />
        </div>
        <div>
          <label class="label">Moneda</label>
          <input name="moneda" class="input" placeholder="USD" />
        </div>
        <div>
          <label class="label">Zona horaria</label>
          <input name="zonaHoraria" class="input" placeholder="America/El_Salvador" />
        </div>
        <div class="flex items-end sm:col-span-2">
          <button type="submit" class="btn-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
            Guardar cambios
          </button>
        </div>
      </form>
    </div>

    <div class="card self-start overflow-hidden">
      <div class="relative bg-gradient-to-br from-brand-700 via-brand-600 to-flare-600 px-6 py-8 text-center">
        <div class="pointer-events-none absolute -top-8 -right-8 size-32 rounded-full bg-white/10 blur-2xl"></div>
        <div class="relative">
          <div class="mx-auto flex size-16 items-center justify-center rounded-2xl bg-white/15 text-2xl font-extrabold text-white ring-1 ring-white/25 backdrop-blur">S</div>
          <h3 class="mt-4 text-lg font-extrabold text-white" id="prev-name">Institución</h3>
          <p class="mt-1 text-xs font-medium text-brand-100" id="prev-info">—</p>
        </div>
      </div>
      <div class="space-y-3 px-6 py-5 text-sm">
        <div class="flex justify-between"><span class="font-semibold text-ink-soft">Teléfono</span><span class="font-bold text-ink" id="prev-tel">—</span></div>
        <div class="flex justify-between"><span class="font-semibold text-ink-soft">Correo</span><span class="font-bold text-ink" id="prev-mail">—</span></div>
        <div class="flex justify-between"><span class="font-semibold text-ink-soft">Nota de aprobación</span><span class="font-bold text-ink" id="prev-nota">—</span></div>
        <div class="flex justify-between"><span class="font-semibold text-ink-soft">Moneda</span><span class="font-bold text-ink" id="prev-moneda">—</span></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { toast } from '../lib/ui';
  import { apiGet, apiPut } from '../lib/api';

  const form = document.getElementById('cfg-form');
  const fields = [
    'nombreInstitucion', 'direccion', 'telefono', 'correo', 'sitioWeb', 'logoUrl',
    'escalaMinima', 'escalaMaxima', 'notaAprobacion', 'moneda', 'zonaHoraria',
  ];

  const prev = {
    name: document.getElementById('prev-name'),
    info: document.getElementById('prev-info'),
    tel: document.getElementById('prev-tel'),
    mail: document.getElementById('prev-mail'),
    nota: document.getElementById('prev-nota'),
    moneda: document.getElementById('prev-moneda'),
  };

  function updatePreview(cfg) {
    prev.name.textContent = cfg.nombreInstitucion || 'Institución';
    prev.info.textContent = cfg.direccion || '—';
    prev.tel.textContent = cfg.telefono || '—';
    prev.mail.textContent = cfg.correo || '—';
    prev.nota.textContent = cfg.notaAprobacion ?? '—';
    prev.moneda.textContent = cfg.moneda || '—';
  }

  // Cargar configuración
  apiGet('/configuracion')
    .then((cfg) => {
      fields.forEach((f) => {
        const el = form.elements[f];
        if (el && cfg[f] != null) el.value = cfg[f];
      });
      updatePreview(cfg);
    })
    .catch(() => {
      toast('No se pudo cargar la configuración', 'error');
    });

  // Actualizar en vivo la preview
  fields.forEach((f) => {
    const el = form.elements[f];
    if (!el) return;
    el.addEventListener('input', () => {
      const cfg = {};
      fields.forEach((k) => { cfg[k] = form.elements[k].value || null; });
      updatePreview(cfg);
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {};
    fields.forEach((f) => {
      let v = form.elements[f].value.trim();
      if (['escalaMinima', 'escalaMaxima', 'notaAprobacion'].includes(f) && v !== '') v = Number(v);
      payload[f] = v === '' ? null : v;
    });
    try {
      await apiPut('/configuracion', payload);
      toast('Configuración guardada correctamente', 'success');
    } catch (err) {
      toast(err.message || 'No se pudo guardar', 'error');
    }
  });
</script>