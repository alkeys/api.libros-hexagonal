---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Iniciar sesión · Sistema Escolar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="relative flex min-h-dvh items-center justify-center overflow-hidden bg-gradient-to-br from-brand-950 via-[#2a0b5e] to-[#3d0f7a] p-4">
      <!-- Decoración -->
      <div class="pointer-events-none absolute -top-24 -left-24 size-96 rounded-full bg-brand-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -right-24 -bottom-24 size-96 rounded-full bg-flare-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute top-1/3 right-1/4 size-40 rounded-full bg-white/5 blur-2xl"></div>

      <div class="card modal-anim relative w-full max-w-md overflow-hidden">
        <div class="relative bg-gradient-to-r from-brand-600 to-flare-600 px-8 pt-10 pb-14 text-center">
          <div class="pointer-events-none absolute -top-10 -right-10 size-40 rounded-full bg-white/10 blur-2xl"></div>
          <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-white/15 text-2xl font-extrabold text-white ring-1 ring-white/25 backdrop-blur">
            S
          </div>
          <h1 class="mt-4 text-2xl font-extrabold text-white">Sistema Escolar</h1>
          <p class="mt-1 text-sm font-medium text-brand-100">Inicia sesión para continuar</p>
        </div>

        <form id="login-form" class="relative -mt-8 space-y-4 px-8 pt-8 pb-8">
          <div class="mx-auto h-16 w-16 -translate-y-1 rounded-2xl bg-white shadow-lg shadow-brand-950/10"></div>
          <div class="-mt-6 space-y-4">
            <div>
              <label class="label">Usuario</label>
              <div class="relative">
                <svg class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                <input name="username" type="text" required autocomplete="username" placeholder="tu.usuario" class="input pl-10" />
              </div>
            </div>
            <div>
              <label class="label">Contraseña</label>
              <div class="relative">
                <svg class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                <input name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="input pl-10" />
              </div>
            </div>
            <button type="submit" class="btn-primary w-full !py-3">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
              Iniciar sesión
            </button>
          </div>
          <p class="pt-2 text-center text-xs font-medium text-ink-soft">
            ¿Primera vez? Crea tu usuario desde <a href="/usuarios" class="font-bold text-brand-600 hover:underline">Usuarios</a>.
          </p>
        </form>
      </div>
    </div>

    <script>
      import { toast } from '../lib/ui';

      const form = document.getElementById('login-form');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Ingresando…';

        try {
          const { apiPost } = await import('../lib/api');
          const { setSession } = await import('../lib/session');
          const session = await apiPost('/usuarios/login', {
            username: form.elements.username.value.trim(),
            password: form.elements.password.value,
          });
          setSession(session);
          toast('¡Bienvenido!', 'success');
          setTimeout(() => location.replace('/'), 400);
        } catch (err) {
          toast(err.message || 'Credenciales inválidas', 'error');
          btn.disabled = false;
          btn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>\n              Iniciar sesión';
        }
      });
    </script>
  </body>
</html>