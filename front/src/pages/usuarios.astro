---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Usuarios" active="usuarios">
  <div id="crud-root"></div>
</Layout>

<script>
  import { createCrudPage, badge } from '../lib/crud';
  import { esc, openModal, toast } from '../lib/ui';
  import { apiGet, apiPut } from '../lib/api';

  const ROLE_COLOR = {
    ADMIN: 'bg-rose-50 text-rose-700 ring-rose-600/20',
    DIRECTOR: 'bg-violet-50 text-violet-700 ring-violet-600/20',
    PROFESOR: 'bg-sky-50 text-sky-700 ring-sky-600/20',
    ESTUDIANTE: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
    REPRESENTANTE: 'bg-amber-50 text-amber-700 ring-amber-600/25',
  };

  function roleBadges(roles) {
    const lista = roles || [];
    if (!lista.length) return '<span class="text-xs font-semibold text-ink-soft">Sin roles</span>';
    return lista
      .map(
        (r) =>
          `<span class="badge ring-1 ring-inset ${ROLE_COLOR[r] || 'bg-slate-100 text-slate-600 ring-slate-500/20'}">${esc(r)}</span>`,
      )
      .join(' ');
  }

  function openRolesModal(item, reload) {
    apiGet('/usuarios/roles')
      .then((roles) => {
        const actuales = (item.roles || []).map((r) => String(r).toUpperCase());
        const body = `
          <div class="sm:col-span-2">
            <p class="mb-1 text-sm font-bold text-ink">Roles de @${esc(item.username)}</p>
            <p class="mb-3 text-xs text-ink-soft">Marca los roles que tendrá este usuario. Los cambios aplican en su próximo inicio de sesión.</p>
            <div class="space-y-2">
              ${(roles || [])
                .map(
                  (rol) => `
                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 transition hover:border-brand-300 hover:bg-brand-50/40 ${actuales.includes(String(rol.nombre).toUpperCase()) ? 'border-brand-300 bg-brand-50/40' : ''}">
                      <input type="checkbox" name="rol" value="${esc(rol.nombre)}" class="size-4 accent-brand-600" ${actuales.includes(String(rol.nombre).toUpperCase()) ? 'checked' : ''} />
                      <span class="flex-1">
                        <span class="block text-sm font-extrabold text-ink">${esc(rol.nombre)}</span>
                        ${rol.descripcion ? `<span class="block text-xs text-ink-soft">${esc(rol.descripcion)}</span>` : ''}
                      </span>
                      <span class="badge ring-1 ring-inset ${ROLE_COLOR[rol.nombre] || 'bg-slate-100 text-slate-600 ring-slate-500/20'}">${esc(rol.nombre)}</span>
                    </label>`,
                )
                .join('')}
            </div>
          </div>`;
        openModal({
          title: `Asignar roles · @${esc(item.username)}`,
          size: 'max-w-lg',
          submitLabel: 'Guardar roles',
          body,
          onSubmit: async (form) => {
            const roles = form.getAll('rol');
            await apiPut(`/usuarios/${item.id}/roles`, { roles });
            toast('Roles actualizados correctamente', 'success');
            reload();
          },
        });
      })
      .catch((err) => toast(err.message || 'No se pudieron cargar los roles', 'error'));
  }

  createCrudPage({
    root: '#crud-root',
    endpoint: '/usuarios',
    title: 'Usuarios',
    description: 'Cuentas de acceso y asignación de roles.',
    createLabel: 'Nuevo usuario',
    searchKeys: ['username', 'correo'],
    emptyText: 'No hay usuarios registrados todavía.',
    columns: [
      {
        label: 'Usuario',
        render: (r) => `
          <div class="flex items-center gap-3">
            <div class="flex size-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-flare-500 text-xs font-extrabold text-white">${esc((r.username || '?').slice(0, 2).toUpperCase())}</div>
            <p class="font-bold text-ink">@${esc(r.username || '—')}</p>
          </div>`,
      },
      { label: 'Correo', render: (r) => esc(r.correo || '—') },
      { label: 'Roles', render: (r) => `<div class="flex max-w-64 flex-wrap gap-1">${roleBadges(r.roles)}</div>` },
      { label: 'Estado', render: (r) => badge(r.estado) },
    ],
    fields: [
      { name: 'username', label: 'Usuario', required: true },
      { name: 'password', label: 'Contraseña', placeholder: 'Déjala vacía para no cambiarla', type: 'password' },
      { name: 'correo', label: 'Correo electrónico', type: 'email' },
    ],
    extraActions: [
      {
        title: 'Asignar roles',
        cls: 'btn-icon',
        svg: `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>`,
        onClick: openRolesModal,
      },
    ],
  });
</script>
