---
import '../styles/global.css';

interface Props {
  title: string;
  active: string;
}

const { title, active } = Astro.props;

const nav = [
  { href: '/', key: 'inicio', label: 'Inicio', icon: 'home', roles: [] },
  { href: '/estudiantes', key: 'estudiantes', label: 'Estudiantes', icon: 'users', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/profesores', key: 'profesores', label: 'Profesores', icon: 'user', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/materias', key: 'materias', label: 'Materias', icon: 'book', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/niveles', key: 'niveles', label: 'Niveles y Grados', icon: 'layers', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/grupos', key: 'grupos', label: 'Grupos', icon: 'grid', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/horarios', key: 'horarios', label: 'Horarios y Aulas', icon: 'clock', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/evaluaciones', key: 'evaluaciones', label: 'Evaluaciones', icon: 'clipboard', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/notas', key: 'notas', label: 'Notas', icon: 'pencil', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/asistencia', key: 'asistencia', label: 'Asistencia', icon: 'calendar-check', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/anios-escolares', key: 'anios', label: 'Años Escolares', icon: 'calendar', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/representantes', key: 'representantes', label: 'Representantes', icon: 'heart', roles: ['ADMIN', 'PROFESOR'] },
  { href: '/mis-notas', key: 'mis-notas', label: 'Mis Notas', icon: 'clipboard-check', roles: ['ESTUDIANTE'] },
  { href: '/usuarios', key: 'usuarios', label: 'Usuarios', icon: 'lock', roles: ['ADMIN'] },
  { href: '/configuracion', key: 'configuracion', label: 'Configuración', icon: 'cog', roles: ['ADMIN'] },
];

const icons: Record<string, string> = {
  home: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25',
