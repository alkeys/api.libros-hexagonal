---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Sistema Escolar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="min-h-dvh bg-surface lg:pl-72">
      <!-- Sidebar -->
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col bg-gradient-to-b from-brand-950 via-[#2a0b5e] to-[#3d0f7a] transition-transform duration-300 lg:translate-x-0"
      >
        <div class="flex items-center gap-3 px-6 pt-6 pb-5">
          <div class="flex size-11 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-400 to-flare-500 text-lg font-extrabold text-white shadow-lg shadow-brand-900/40">
            S
          </div>
          <div>
            <p class="text-base leading-tight font-extrabold text-white">Sistema Escolar</p>
            <p class="text-xs font-medium text-brand-200">Gestión académica</p>
          </div>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-2">
          {nav.map((item) => (
            <a
              href={item.href}
              data-nav-roles={item.roles.join('|')}
              class:list={[
                'group flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all',
                active === item.key
                  ? 'bg-white/10 text-white shadow-inner'
                  : 'text-brand-100/80 hover:bg-white/5 hover:text-white',
              ]}
            >
              <svg
                class:list={['size-5 shrink-0 transition', active === item.key ? 'text-flare-400' : 'text-brand-300/70 group-hover:text-brand-200']}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon]} />
              </svg>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="m-3 rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-emerald-400" id="api-dot"></span>
            <p class="text-xs font-semibold text-white" id="api-status">Verificando API…</p>
          </div>
          <p class="mt-1 text-[11px] text-brand-200/70">Backend: localhost:8080</p>
        </div>
      </aside>

      <!-- Overlay móvil -->
      <div id="overlay" class="fixed inset-0 z-30 hidden bg-brand-950/50 backdrop-blur-sm lg:hidden"></div>

      <!-- Contenido -->
      <div class="flex min-h-dvh flex-col">
        <header class="sticky top-0 z-20 border-b border-slate-200/70 bg-surface/85 backdrop-blur-lg">
          <div class="flex items-center gap-3 px-4 py-3.5 sm:px-6 lg:px-8">
            <button
              id="menu-btn"
              class="rounded-xl border border-slate-200 bg-white p-2 text-ink-soft transition hover:text-ink lg:hidden"
              aria-label="Abrir menú"
            >
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
            </button>
            <div>
              <h1 class="text-lg font-extrabold tracking-tight text-ink sm:text-xl">{title}</h1>
              <p class="hidden text-xs font-medium text-ink-soft sm:block" id="today"></p>
            </div>
            <div class="ml-auto flex items-center gap-3">
              <div class="hidden items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-1.5 sm:flex">
                <span class="size-2 rounded-full bg-gradient-to-r from-brand-500 to-flare-500"></span>
                <span class="text-xs font-bold text-ink-soft" id="year-label">—</span>
              </div>
              <div class="hidden flex-col items-end sm:flex">
                <span class="text-xs font-bold text-ink" id="user-name">—</span>
                <span class="text-[10px] font-medium text-ink-soft" id="user-role">—</span>
              </div>
              <div class="flex size-10 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-flare-500 text-sm font-extrabold text-white shadow-md shadow-brand-500/30" id="user-avatar">
                —
              </div>
              <button id="logout-btn" class="rounded-xl border border-slate-200 bg-white p-2 text-ink-soft transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600" title="Cerrar sesión">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
              </button>
            </div>
          </div>
        </header>

        <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
          <slot />
        </main>

        <footer class="px-4 pb-6 text-center text-xs font-medium text-ink-soft/60 sm:px-6">
          Sistema Escolar · API v1 · El Salvador
        </footer>
      </div>
    </div>

    <script>
      // Menú móvil
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      const menuBtn = document.getElementById('menu-btn');

      function closeMenu() {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
      }
      menuBtn?.addEventListener('click', () => {
        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
      });
      overlay?.addEventListener('click', closeMenu);
      sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

      // Sesión: guarda de acceso
      import('../lib/session').then(({ getSession, clearSession }) => {
        const session = getSession();
        if (!session && !location.pathname.startsWith('/login')) {
          location.replace('/login');
          return;
        }
        // Estudiantes (sin rol admin/profesor) van directo a su portal de notas
        if (session && !(session.roles || []).some((r) => ['ADMIN', 'PROFESOR'].includes(r))) {
          const esEstudiante = (session.roles || []).includes('ESTUDIANTE') || session.idEstudiante;
          if (esEstudiante && !location.pathname.startsWith('/mis-notas') && !location.pathname.startsWith('/login')) {
            location.replace('/mis-notas');
            return;
          }
        }
        if (session) {
          const roles = session.roles || [];
          const userAvatar = document.getElementById('user-avatar');
          const userName = document.getElementById('user-name');
          const userRole = document.getElementById('user-role');
          if (userAvatar) userAvatar.textContent = (session.username || '?').slice(0, 2).toUpperCase();
          if (userName) userName.textContent = session.username || '';
          if (userRole) {
            const esAdmin = roles.includes('ADMIN');
            const esProfesor = roles.includes('PROFESOR');
            const esEstudiante = roles.includes('ESTUDIANTE');
            if (esAdmin) userRole.textContent = 'Administrador';
            else if (esProfesor) userRole.textContent = 'Profesor';
            else if (esEstudiante) userRole.textContent = 'Estudiante';
            else if (session.idProfesor) userRole.textContent = 'Profesor';
            else if (session.idEstudiante) userRole.textContent = 'Estudiante';
            else userRole.textContent = 'Administrador';
          }

          // Ocultar enlaces del menú que no corresponden al rol
          const tieneRol = (req) => !req.length || req.some((r) => roles.includes(r));
          document.querySelectorAll('nav [data-nav-roles]').forEach((link) => {
            const req = link.dataset.navRoles ? link.dataset.navRoles.split('|') : [];
            if (!tieneRol(req)) link.remove();
          });

          document.getElementById('logout-btn')?.addEventListener('click', () => {
            clearSession();
            location.href = '/login';
          });
        }
      });

      // Fecha de hoy
      const today = document.getElementById('today');
      if (today) {
        today.textContent = new Date().toLocaleDateString('es-SV', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
      }
      const yearLabel = document.getElementById('year-label');
      if (yearLabel) yearLabel.textContent = new Date().getFullYear();

      // Estado de la API
      import('../lib/api').then(({ apiGet }) => {
        const dot = document.getElementById('api-dot');
        const status = document.getElementById('api-status');
        apiGet('/configuracion')
          .then((cfg) => {
            dot.className = 'size-2 rounded-full bg-emerald-400';
            status.textContent = cfg?.nombreInstitucion || 'API en línea';
          })
          .catch(() => {
            dot.className = 'size-2 rounded-full bg-rose-400';
            status.textContent = 'API fuera de línea';
          });
      });
    </script>
  </body>
</html>